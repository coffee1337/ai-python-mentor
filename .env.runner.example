# Execution worker environment. No database, AI or payment credentials here.
# Mount the generated PKI and the exported catalog into /etc/ai-tutor-runner.

RUNNER_STATE_DIR=/var/lib/ai-tutor-runner
RUNNER_CATALOG_FILE=/etc/ai-tutor-runner/catalog.json
RUNNER_HOST_ATTESTATION_FILE=/etc/ai-tutor-runner/host-attestation.json

# auto|docker|landlock. `auto` prefers the container runtime when it is usable.
RUNNER_SANDBOX_BACKEND=auto

# Docker backend only (RUNNER_SANDBOX_BACKEND=docker):
# SANDBOX_IMAGE=registry.example/python-sandbox@sha256:REPLACE
# SANDBOX_SECCOMP_FILE=/etc/ai-tutor-runner/seccomp.json

RUNNER_BIND=0.0.0.0
RUNNER_PORT=8443
RUNNER_ALLOWED_API_IDENTITIES=spiffe://ai-tutor/api
RUNNER_AUTH_TOKEN=CHANGE_ME_LONG_RANDOM
RUNNER_CLIENT_CA_FILE=/etc/ai-tutor-runner/ca.pem
RUNNER_SERVER_CERT_FILE=/etc/ai-tutor-runner/server.pem
RUNNER_SERVER_KEY_FILE=/etc/ai-tutor-runner/server.key
