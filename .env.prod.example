# Production environment. Copy to .env.prod, fill in, never commit.
# `docker compose -f compose.prod.yml --env-file .env.prod up -d` reads this file.

# --- Domain and TLS (Caddy issues the certificate automatically) ---
DOMAIN=mentor.example.com
ACME_EMAIL=owner@example.com

# --- Database ---
POSTGRES_DB=mentor
POSTGRES_USER=mentor
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM

# --- Application ---
APP_ENV=production
COOKIE_SECURE=true
WEB_ORIGINS=https://mentor.example.com
API_WORKERS=2
LOG_LEVEL=INFO

# --- AI gateway (owner-provided, OpenAI-compatible) ---
AI_GATEWAY_URL=https://ru.cheapvibecode.ru/v1/chat/completions
AI_GATEWAY_API_KEY=CHANGE_ME
AI_GATEWAY_TIMEOUT_SECONDS=40
AI_GATEWAY_TOTAL_BUDGET_SECONDS=45
AI_MODEL_ROUTING_FILE=/app/config/model-routing.json
AI_SPEND_DAILY_LIMIT_USD=5
AI_MAX_CALL_COST_MICROUSD=20000
AI_DAILY_CALL_LIMIT=100
AI_WARMUP_ENABLED=1

# --- Email delivery (provider-specific; see docs/RUNBOOK.md) ---
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Billing ---
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=

# --- Runner (private mTLS endpoint of the execution worker) ---
RUNNER_URL=https://runner:8443/internal/v1/runner/executions
RUNNER_AUTH_TOKEN=CHANGE_ME_LONG_RANDOM
RUNNER_CA_FILE=/etc/ai-tutor/api/ca.pem
RUNNER_CLIENT_CERT_FILE=/etc/ai-tutor/api/client.pem
RUNNER_CLIENT_KEY_FILE=/etc/ai-tutor/api/client.key
RUNNER_VERIFIED_POLICY_FILE=/etc/ai-tutor/api/policy.json
RUNNER_REQUEST_TIMEOUT_SECONDS=20
EXECUTION_JOBS_ENABLED=true

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Browser build-time DSN: it also allow-lists the ingest host in the CSP.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
