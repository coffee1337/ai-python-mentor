POSTGRES_DB=mentor
POSTGRES_USER=mentor
POSTGRES_PASSWORD=change_this_local_password
APP_ENV=development
API_WORKERS=2
# Local API outside Docker: use localhost. Compose overrides this with the service hostname.
DATABASE_URL=postgresql+psycopg://mentor:change_this_local_password@localhost:5432/mentor
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://localhost:8000
WEB_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Server-only: full HTTPS Chat Completions endpoint, exact model ID and key.
# Blank disables mentor chat. No vendor or model is assumed.
AI_GATEWAY_URL=
AI_GATEWAY_MODEL=gpt-6-luna
AI_GATEWAY_API_KEY=
AI_GATEWAY_TIMEOUT_SECONDS=20

# Server-only private Runner endpoint (full protocol URL or private service base URL).
# Leave URL/token blank to keep code execution disabled (fail-closed).
RUNNER_URL=
RUNNER_AUTH_TOKEN=
RUNNER_REQUEST_TIMEOUT_SECONDS=20
# Real transport requires all four paths, a HTTPS endpoint and reviewed policy.
# Mount certificates outside image layers using your deployment's secrets mechanism.
RUNNER_CA_FILE=
RUNNER_CLIENT_CERT_FILE=
RUNNER_CLIENT_KEY_FILE=
RUNNER_VERIFIED_POLICY_FILE=
EXECUTION_JOBS_ENABLED=false

# Knowledge Base / RAG: local deterministic retrieval works without paid embeddings.
# These settings opt into externally generated embeddings via the gateway.
AI_GATEWAY_EMBEDDINGS_URL=
AI_GATEWAY_EMBEDDINGS_MODEL=
AI_GATEWAY_EMBEDDINGS_DIMENSION=

# Durable AI admission; cost remains estimated unless exact usage and prices are supplied.
AI_DAILY_CALL_LIMIT=100
AI_DAILY_BUDGET_MICROUSD=0
AI_MAX_CALL_COST_MICROUSD=0
AI_PRICED_MODEL_ID=
AI_INPUT_MICROUSD_PER_MILLION_TOKENS=0
AI_OUTPUT_MICROUSD_PER_MILLION_TOKENS=0
# Accounts: development-only raw links are disabled by default.
DEV_ACCOUNT_TOKENS=false
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Provider-neutral checkout service and signed event adapter; no default charges.
BILLING_CHECKOUT_URL=
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=
# Exact account UUIDs, comma-separated. Never inferred from an email domain.
ADMIN_USER_IDS=
